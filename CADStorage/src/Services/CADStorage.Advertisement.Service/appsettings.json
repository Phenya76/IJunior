{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "IncludeScopes": true,
      "ColorBehavior": "Enabled"
    }
  },
  "AllowedHosts": "*",
  
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=cadstorage_ads;Username=postgres;Password=postgres",
    "Redis": "localhost:6379",
    "RabbitMQ": "rabbitmq://localhost"
  },
  
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyForJWTTokenGenerationMustBeLongEnough123!",
    "Issuer": "CADStorage.Advertisement.Service",
    "Audience": "CADStorage.Frontend",
    "ExpirationInMinutes": 60
  },
  
  "AdvertisementSettings": {
    "AdFrequency": 5,
    "MinModelsBeforeFirstAd": 3,
    "MaxAdsPerPage": 3
  },
  
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  }
}
